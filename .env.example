# Copia a backend/.env y ajusta. Todos los valores tienen defaults sensatos para local.

APP_NAME=Nómina Hub
ENVIRONMENT=local

# Base de datos. Por defecto SQLite (arranque sin dependencias).
# PostgreSQL: postgresql+psycopg2://nomina:nomina@db:5432/nominahub
# DATABASE_URL=postgresql+psycopg2://nomina:nomina@db:5432/nominahub

# Seguridad
SECRET_KEY=cambia-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Email / gestoría (si SMTP_HOST está vacío => modo registro, no envía de verdad)
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=secreto
SMTP_FROM=nominahub@grupo.com
GESTORIA_EMAIL=nominas@gestoria-ejemplo.es

# Factorial (stub = simulado | live = API real)
FACTORIAL_MODE=stub
# FACTORIAL_API_KEY=...

# Autoline
AUTOLINE_DETAIL_LEVEL=summary   # summary | employee
AUTOLINE_DEFAULT_COMPANY_CODE=01
